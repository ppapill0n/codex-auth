#!/usr/bin/env python3
"""Store and select auth.json files; all Codex state stays in ~/.codex."""
import argparse
import base64
import binascii
import errno
import hashlib
import json
import os
from pathlib import Path
import re
import select
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

MAX_BYTES = 1024 * 1024
PROC_ROOT = Path('/proc')
CODEX_EXECUTABLES = {'codex', 'codex-exec-server', 'codex-code-mode-host', 'codex-voice-host'}
NAME_PATTERN = r'[A-Za-z0-9][A-Za-z0-9_.+\-]{0,63}'


class AuthError(Exception):
    pass


def profile_name(value):
    name = value.removesuffix('.json')
    if not re.fullmatch(NAME_PATTERN, name):
        raise argparse.ArgumentTypeError(
            '이름은 영문/숫자로 시작하는 1~64자의 영문, 숫자, _, -, ., +만 가능합니다.')
    return name


def token_claims(token):
    if not isinstance(token, str) or len(token.split('.')) != 3:
        return {}
    payload = token.split('.')[1]
    if not re.fullmatch(r'[A-Za-z0-9_-]+', payload):
        return {}
    try:
        claims = json.loads(base64.b64decode(payload + '=' * (-len(payload) % 4),
                                            altchars=b'-_', validate=True))
    except (ValueError, binascii.Error, UnicodeError, RecursionError):
        return {}
    return claims if isinstance(claims, dict) else {}


def inferred_name(content):
    tokens = json.loads(content).get('tokens')
    if isinstance(tokens, dict):
        for field in ('id_token', 'access_token'):
            claims = token_claims(tokens.get(field))
            profile = claims.get('https://api.openai.com/profile', {})
            email = claims.get('email') or (profile.get('email') if isinstance(profile, dict) else None)
            if not isinstance(email, str) or email.count('@') != 1:
                continue
            name, domain = email.strip().split('@')
            if not domain or not re.fullmatch(NAME_PATTERN, name):
                raise AuthError('이메일 앞부분을 파일 이름으로 사용할 수 없습니다. save <이름>을 지정하세요.')
            # JWT decoding here is only a filename hint, never authentication.
            # Unlike a CLI filename, an email local part ending in .json stays intact.
            return name
    raise AuthError('인증 파일에서 이메일을 찾을 수 없습니다 (API 키 등). save <이름>을 지정하세요.')


def fingerprint(content):
    """Ignore JSON formatting/key order; retain every credential and metadata field."""
    canonical = json.dumps(json.loads(content), sort_keys=True, separators=(',', ':'), ensure_ascii=True)
    return hashlib.sha256(canonical.encode()).digest()


def account_identity(content):
    """Conservative local matching, not verification of JWT authenticity.

    Email alone is never sufficient to overwrite a saved credential. A ChatGPT
    match needs issuer + subject + selected account/workspace ID. Unknown auth
    formats can still be preserved through exact content matching or a new name.
    """
    value = json.loads(content)
    tokens = value.get('tokens')
    api_key = value.get('OPENAI_API_KEY')
    mode = value.get('auth_mode')
    if isinstance(api_key, str) and api_key and not tokens and mode in (None, 'api_key', 'apikey'):
        return ('api_key', hashlib.sha256(api_key.encode()).digest())
    if mode not in (None, 'chatgpt') or not isinstance(tokens, dict) or api_key:
        return None
    claims = token_claims(tokens.get('id_token'))
    issuer, subject, account = claims.get('iss'), claims.get('sub'), tokens.get('account_id')
    if not all(isinstance(v, str) and v.strip() for v in (issuer, subject, account)):
        return None
    auth_claim = claims.get('https://api.openai.com/auth')
    if isinstance(auth_claim, dict) and auth_claim.get('chatgpt_account_id') not in (None, account):
        return None
    return ('chatgpt', issuer, subject, account)


def saved_profiles(vault):
    """Bounded-size reads, O(number of saved profiles), no persisted identity index."""
    profiles, skipped = [], 0
    for path in sorted(vault.glob('*.json')):
        try:
            profile_name(path.name)
        except argparse.ArgumentTypeError:
            continue
        try:
            content = read_auth(path)
        except (AuthError, OSError):
            skipped += 1
            continue
        profiles.append((path, fingerprint(content), account_identity(content)))
    if skipped:
        print(f'비교에서 제외한 읽을 수 없거나 유효하지 않은 저장본: {skipped}개')
    return profiles


def current_name(vault):
    marker = vault / '.current'
    if not os.path.lexists(marker):
        return None
    value = json.loads(read_auth(marker)).get('name')
    if not isinstance(value, str) or not re.fullmatch(NAME_PATTERN, value):
        raise AuthError('현재 선택 기록이 잘못됐습니다. save <이름>으로 다시 저장하세요.')
    return value


def remember_current(vault, name):
    # One name only. No history, timestamps, tokens, or identity index.
    atomic_copy((json.dumps({'name': name}) + '\n').encode(), vault / '.current', overwrite=True)


def matching_names(content, profiles, preferred):
    digest, identity = fingerprint(content), account_identity(content)
    exact = [path.stem for path, saved_digest, _ in profiles if digest == saved_digest]
    same = [path.stem for path, _, saved_identity in profiles
            if identity is not None and identity == saved_identity]
    # A recorded name is only a tie-breaker after checking the actual credentials.
    if preferred in exact or preferred in same:
        return preferred
    if len(exact) == 1:
        return exact[0]
    if not exact and len(same) == 1:
        return same[0]
    return None


def same_account(first, second):
    if fingerprint(first) == fingerprint(second):
        return True
    identity = account_identity(first)
    return identity is not None and identity == account_identity(second)


def show_switches(active, vault):
    profiles, preferred = [], None
    if os.path.lexists(vault):
        checked_directory(vault)
        profiles, preferred = saved_profiles(vault), current_name(vault)
    content = read_auth(active) if os.path.lexists(active) else None
    selected = matching_names(content, profiles, preferred) if content is not None else None
    for path, _, _ in profiles:
        print(('→ ' if path.stem == selected else '  ') + path.stem)
    if not profiles:
        print('이용 가능한 저장 계정이 없습니다.')
    if content is None:
        print('현재: 로그아웃 상태 (auth.json 없음)')
    elif selected is None:
        print('현재: 미등록 또는 식별 불가. 직접 로그인했거나 저장본이 모호합니다. '
              'save [이름]으로 등록하세요.')
    elif selected != preferred:
        print(f'현재: {selected} (실제 인증에서 자동 감지; 선택 기록과 다를 수 있음)')


def switch_account(active, vault, name):
    require_idle()
    checked_directory(vault)
    target = vault / (name + '.json')
    chosen = read_auth(target)  # Validate the requested target before saving anything.
    previous = read_auth(active) if os.path.lexists(active) else None
    if previous is not None:
        selected = matching_names(previous, saved_profiles(vault), current_name(vault))
        if selected is None:
            raise AuthError('현재 인증의 저장 이름을 확인할 수 없습니다. save [이름]으로 먼저 등록한 뒤 '
                            'switch 하세요. 현재 인증과 저장본은 변경하지 않았습니다.')
        source = vault / (selected + '.json')
        if not same_account(previous, read_auth(source)):
            raise AuthError('현재 계정의 저장본이 바뀌었습니다. 전환하지 않았습니다.')
        if read_auth(active) != previous:
            raise AuthError('현재 인증이 처리 중 변경됐습니다. 전환하지 않았습니다.')
        atomic_copy(previous, source, overwrite=True, before_publish=require_idle)
        print(f'현재 인증 자동 저장됨: {selected}')
        # Switching to the selected name must not restore its stale tokens.
        if same_account(previous, chosen):
            chosen = previous

    def before_switch():
        require_idle()
        now = read_auth(active) if os.path.lexists(active) else None
        if now != previous:
            raise AuthError('현재 인증이 처리 중 변경됐습니다. 전환하지 않았습니다.')

    atomic_copy(chosen, active, overwrite=True, before_publish=before_switch)
    try:
        remember_current(vault, name)
    except (AuthError, OSError):
        raise AuthError('인증 전환은 완료됐지만 현재 선택 이름을 저장하지 못했습니다. switch로 실제 인증을 확인하세요.') from None
    print(f'선택됨: {name} → {active}')
    print('이제 codex 또는 codex resume을 실행하세요.')


def logout(active, vault):
    require_idle()
    marker = vault / '.current'
    if os.path.lexists(vault):
        checked_directory(vault)
        if os.path.lexists(marker):
            checked_file(marker)
    existed = os.path.lexists(active)
    if existed:
        checked_file(active)  # No JSON/identity parsing: logout is just local removal.
        active.unlink()
        directory = os.open(active.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    marker.unlink(missing_ok=True)
    print('로그아웃됨: auth.json 제거 (자동 저장 없음). 새 계정은 codex-auth login으로 인증하세요.'
          if existed else '이미 로그아웃 상태입니다 (auth.json 없음).')


def install_command(base):
    source = Path(__file__).resolve()
    checked_directory(base / '.local', create=True)
    bindir = base / '.local/bin'
    checked_directory(bindir, create=True)
    target = bindir / 'codex-auth'
    if os.path.lexists(target):
        if not target.is_symlink() or target.resolve() != source:
            raise AuthError(f'다른 파일이 있어 설치하지 않았습니다: {target}')
    else:
        target.symlink_to(source)
    print(f'명령 설치됨: {target}')
    paths = [Path(p).expanduser().resolve() for p in os.environ.get('PATH', '').split(os.pathsep) if p]
    if bindir.resolve() not in paths:
        print('현재 셸에 PATH를 추가하세요: export PATH=' + shlex.quote(str(bindir)) + ':"$PATH"')
        print('새 셸에서도 사용하려면 같은 설정을 셸 시작 파일에 추가하세요.')


def process_owner(path):
    return path.stat().st_uid


def stat_fields(path):
    text = (path / 'stat').read_text()
    comm, rest = text.split('(', 1)[1].rsplit(') ', 1)
    fields = rest.split()
    return comm, fields[0], int(fields[1]), int(fields[4]), fields[19]


def process_info(pid):
    path = PROC_ROOT / str(pid)
    try:
        # Check UID before reading any other metadata, arguments, or files.
        try:
            owner = process_owner(path)
        except PermissionError:
            # hidepid configurations can expose names but deny stat on other
            # users' /proc directories. Own processes remain visible on Linux.
            return None
        if owner != os.getuid():
            return None
        comm, state, parent, tty, start = stat_fields(path)
        executable = None
        try:
            executable = str((path / 'exe').readlink()).removesuffix(' (deleted)')
        except (FileNotFoundError, PermissionError):
            pass  # Zombies have no exe. Uninspectable matching names block switch.
        name_matches = comm in {name[:15] for name in CODEX_EXECUTABLES}
        verified = executable is not None and Path(executable).name in CODEX_EXECUTABLES
        if not verified and not name_matches:
            return None
        if executable is not None and not verified:
            return None  # A different executable that merely set its process title.
        kind = 'codex' if executable is None else Path(executable).name
        if verified and kind == 'codex':
            try:
                argv = (path / 'cmdline').read_bytes().split(b'\0')
                if b'app-server' in argv:
                    kind = 'app-server'
            except PermissionError:
                pass
        if stat_fields(path)[4] != start or process_owner(path) != os.getuid():
            return None  # Exited/reused or changed owner while reading.
        return {'pid': pid, 'ppid': parent, 'state': state, 'tty': bool(tty),
                'start': start, 'kind': kind, 'executable': executable, 'verified': verified}
    except (FileNotFoundError, ProcessLookupError):
        return None
    except (PermissionError, ValueError, IndexError):
        raise AuthError(f'PID {pid}의 상태를 확인할 수 없습니다. 일반 호스트 터미널에서 다시 실행하세요.') from None


def processes():
    found = []
    for path in PROC_ROOT.iterdir():
        if path.name.isdigit():
            info = process_info(int(path.name))
            if info is not None:
                found.append(info)
    return sorted(found, key=lambda p: p['pid'])


def show_processes(items):
    if not items:
        print('현재 UID에서 실행 중인 Codex 프로세스가 없습니다.')
        return
    print('PID       PPID      상태  종류                   터미널')
    for p in items:
        print(f"{p['pid']:<9} {p['ppid']:<9} {p['state']:<5} {p['kind']:<22} {'있음' if p['tty'] else '없음'}")
    if any(p['state'] == 'Z' for p in items):
        print('Z(좀비)는 이미 종료되어 계정 전환을 막지 않습니다. 표시된 부모(PPID)가 회수해야 합니다.')


def require_idle():
    live = [p for p in processes() if p['state'] not in {'Z', 'X'}]
    if live:
        show_processes(live)
        raise AuthError('같은 UID의 Codex가 실행 중이어서 인증을 변경하지 않았습니다. '
                        '사용 종료 후 다시 실행하거나 status로 확인한 PID를 cleanup <PID>로 정리하세요.')


def wait_handles(handles, timeout):
    pending = dict(handles)
    deadline = time.monotonic() + timeout
    while pending:
        ready, _, _ = select.select(list(pending), [], [], max(0, deadline - time.monotonic()))
        for fd in ready:
            pending.pop(fd, None)
        if time.monotonic() >= deadline:
            break
    return pending


def cleanup(pids, force=False, *, all_processes=False):
    snapshot = {p['pid']: p for p in processes()} if all_processes else {}
    if all_processes:
        show_processes(list(snapshot.values()))
        pids = list(snapshot)
        if not pids:
            return
    elif not pids:
        show_processes(processes())
        print('종료 대상을 지정하세요: codex-auth cleanup <PID> [PID ...] 또는 cleanup all')
        return
    if not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
        raise AuthError('PID 재사용을 안전하게 처리하려면 Linux pidfd 지원이 필요합니다.')
    handles = {}
    try:
        # Validate and pin every requested target BEFORE sending any signal.
        for pid in dict.fromkeys(pids):
            info = process_info(pid)
            if info is None:
                if all_processes and not (PROC_ROOT / str(pid)).exists():
                    continue  # A snapshot target already exited; do not chase replacements.
                raise AuthError(f'PID {pid}는 현재 UID의 확인된 Codex 프로세스가 아닙니다. 아무 것도 종료하지 않았습니다.')
            if all_processes and info['start'] != snapshot[pid]['start']:
                raise AuthError(f'PID {pid}가 목록 확인 후 바뀌었습니다. 아무 것도 종료하지 않았습니다.')
            if info['state'] in {'Z', 'X'}:
                print(f'PID {pid}는 이미 종료됨. 부모 PID {info["ppid"]}가 회수해야 하며 종료 신호는 보내지 않습니다.')
                continue
            if all_processes and any(info[k] != snapshot[pid][k] for k in ('executable', 'verified')):
                raise AuthError(f'PID {pid}의 실행 파일이 목록 확인 후 바뀌었습니다. 아무 것도 종료하지 않았습니다.')
            if not info['verified'] or pid in {1, os.getpid()}:
                raise AuthError(f'PID {pid}를 안전하게 확인할 수 없어 종료하지 않았습니다.')
            try:
                fd = os.pidfd_open(pid)
            except ProcessLookupError:
                continue
            handles[fd] = info
            current = process_info(pid)
            if current is None or any(current[k] != info[k] for k in ('start', 'executable', 'verified')):
                raise AuthError(f'PID {pid}의 실행 주체가 바뀌었습니다. 아무 것도 종료하지 않았습니다.')
        for fd, info in handles.items():
            # Recheck UID/executable immediately before signalling; pidfd pins identity.
            current = process_info(info['pid'])
            if current is None:
                continue
            if any(current[k] != info[k] for k in ('start', 'executable', 'verified')):
                raise AuthError(f'PID {info["pid"]}의 실행 주체가 바뀌어 종료를 중단했습니다.')
            try:
                signal.pidfd_send_signal(fd, signal.SIGTERM)
                print(f'PID {info["pid"]}: 정상 종료(SIGTERM) 요청')
            except ProcessLookupError:
                pass
        remaining = wait_handles(handles, 5)
        if remaining and force:
            for fd, info in remaining.items():
                current = process_info(info['pid'])
                if current is not None and all(current[k] == info[k] for k in ('start', 'executable', 'verified')):
                    try:
                        signal.pidfd_send_signal(fd, signal.SIGKILL)
                        print(f'PID {info["pid"]}: 강제 종료(SIGKILL) 요청')
                    except ProcessLookupError:
                        pass
            remaining = wait_handles(remaining, 3)
        if remaining:
            ids = ' '.join(str(p['pid']) for p in remaining.values())
            raise AuthError(f'아직 종료되지 않은 PID: {ids}. 필요하면 cleanup {ids} --force로 강제 종료하세요.')
        if all_processes:
            live = [p for p in processes() if p['state'] not in {'Z', 'X'}]
            if live:
                show_processes(live)
                raise AuthError('정리 후 실행 중인 Codex가 감지됐습니다. 새로 시작되거나 자동 재시작된 '
                                '프로세스는 추가로 종료하지 않았습니다. status로 확인하세요.')
        print('지정한 프로세스 정리가 끝났습니다. status로 다시 확인한 뒤 switch 하세요.')
    finally:
        for fd in handles:
            os.close(fd)


def checked_directory(path, *, create=False, private=False):
    if create:
        path.mkdir(mode=0o700, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise AuthError(f'현재 사용자가 소유한 실제 디렉터리여야 합니다: {path}')
    if private:
        path.chmod(0o700)


def checked_file(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        raise AuthError(f'현재 사용자가 소유한 일반 파일이어야 합니다 (링크 불가): {path}')


def read_auth(path):
    checked_file(path)
    # NOFOLLOW also prevents a symlink replacement between lstat and open.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise AuthError(f'읽을 수 있는 일반 파일이 아닙니다: {path}')
        content = stream.read(MAX_BYTES + 1)
    if len(content) > MAX_BYTES:
        raise AuthError(f'인증 파일이 1 MiB를 초과합니다: {path}')
    try:
        def reject_constant(_):
            raise ValueError('Non-standard JSON')
        value = json.loads(content, parse_constant=reject_constant)
    except (ValueError, UnicodeError, RecursionError):
        # Do not expose a parser exception that may include credential contents.
        raise AuthError(f'올바른 JSON 파일이 아닙니다: {path}') from None
    if not isinstance(value, dict) or not value:
        raise AuthError(f'비어 있지 않은 JSON 객체여야 합니다: {path}')
    # Preserve bytes and unknown fields exactly; Codex owns the auth schema and
    # validates token validity. Decoding for filename inference is separate.
    return content


def atomic_copy(content, destination, *, overwrite, before_publish=None):
    if os.path.lexists(destination):
        checked_file(destination)
        if not overwrite:
            raise AuthError(f'이미 존재합니다: {destination.name}. 덮어쓰려면 --force를 사용하세요.')
    fd, temporary = tempfile.mkstemp(prefix='.codex-auth-', suffix='.tmp', dir=destination.parent)
    temporary = Path(temporary)
    try:
        with os.fdopen(fd, 'wb') as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        if before_publish is not None:
            before_publish()
        if overwrite:
            # Replace the name atomically, never truncate the old credentials first.
            os.replace(temporary, destination)
        else:
            # Atomic no-clobber publication, even if another save created the name.
            try:
                os.link(temporary, destination)
            except FileExistsError:
                raise AuthError(f'이미 존재합니다: {destination.name}. --force로 덮어쓸 수 있습니다.') from None
        directory = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def check_codex_target(root):
    override = os.environ.get('CODEX_HOME')
    if override and Path(override).expanduser().resolve() != root.resolve():
        raise AuthError('CODEX_HOME이 ~/.codex와 다른 곳을 가리킵니다. unset CODEX_HOME 후 다시 실행하세요.')
    config = root / 'config.toml'
    if config.exists():
        try:
            settings = tomllib.loads(config.read_text())
        except (ValueError, UnicodeError):
            raise AuthError('config.toml을 해석할 수 없습니다. 인증 파일은 변경하지 않았습니다.') from None
        mode = settings.get('cli_auth_credentials_store', 'file')
        if mode != 'file':
            raise AuthError('파일 교체를 사용하려면 config.toml의 cli_auth_credentials_store = "file"이 필요합니다.')


def main(argv=None, *, user_root=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    parser = argparse.ArgumentParser(
        description='~/.auth/<이름>.json과 ~/.codex/auth.json을 관리하고 Codex device-auth 로그인을 실행합니다.',
        epilog='Python 3.11+ / Linux. 계정 변경과 로그인은 Codex 사용을 마친 뒤 실행하세요.')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('init', help='~/.auth 생성 및 ~/.local/bin/codex-auth 명령 설치')
    sub.add_parser('list', help='저장된 이름 목록 (인증 내용은 출력하지 않음)')
    sub.add_parser('status', help='현재 UID의 Codex 프로세스 확인')
    sub.add_parser('login', help='codex login --device-auth 실행')
    clean = sub.add_parser('cleanup', help='현재 UID의 Codex PID 또는 all 종료 (생략 시 조회만)')
    clean.add_argument('targets', metavar='PID|all', nargs='*', help='PID 목록 또는 all 단독 지정')
    clean.add_argument('-f', '--force', action='store_true', help='SIGTERM 후에도 남으면 SIGKILL 사용')
    switch = sub.add_parser('switch', help='계정 목록 조회 또는 현재 인증을 자동 저장하고 계정 전환')
    switch.add_argument('name', type=profile_name, nargs='?', help='생략 시 계정 목록과 현재 계정 표시')
    save = sub.add_parser('save', help='현재 인증을 이메일에서 자동으로 정한 이름으로 저장',
                          description='기본 사용: codex-auth save. 이메일의 @ 앞부분을 저장 이름으로 사용합니다.')
    save.add_argument('name', type=profile_name, nargs='?', help='선택사항: 자동 이름 대신 사용할 저장 이름')
    save.add_argument('-f', '--force', action='store_true', help='같은 이름의 저장 파일 덮어쓰기')
    sub.add_parser('logout', help='자동 저장 없이 ~/.codex/auth.json 제거')
    if not argv:
        parser.print_help()
        return 0
    args = parser.parse_args(argv)
    if args.command == 'cleanup':
        if 'all' in args.targets:
            if args.targets != ['all']:
                parser.error('all은 PID와 섞거나 여러 번 지정할 수 없습니다.')
            args.pids = []
        else:
            if any(not re.fullmatch(r'[0-9]+', value) or int(value) <= 0 for value in args.targets):
                parser.error('cleanup 대상은 양의 정수 PID 또는 all이어야 합니다.')
            args.pids = [int(value) for value in args.targets]
    base = Path(user_root) if user_root is not None else Path.home()
    vault, codex = base / '.auth', base / '.codex'
    try:
        if args.command == 'init':
            checked_directory(vault, create=True, private=True)
            install_command(base)
            print(f'준비됨: {vault} (권한 700)')
        elif args.command == 'status':
            show_processes(processes())
        elif args.command == 'cleanup':
            cleanup(args.pids, force=args.force, all_processes=args.targets == ['all'])
        elif args.command == 'list':
            if not os.path.lexists(vault):
                print('저장된 계정이 없습니다. codex-auth save로 저장하세요.')
                return 0
            checked_directory(vault)
            names = []
            for path in vault.glob('*.json'):
                if path.is_symlink() or not path.is_file():
                    continue
                try:
                    name = profile_name(path.name)
                except argparse.ArgumentTypeError:
                    continue
                names.append(name)
            print('\n'.join(sorted(names)) if names else '저장된 계정이 없습니다.')
        elif args.command == 'login':
            require_idle()
            result = subprocess.run(['codex', 'login', '--device-auth'], check=False)
            return result.returncode
        else:
            check_codex_target(codex)
            checked_directory(codex)
            active = codex / 'auth.json'
            if args.command == 'save':
                content = read_auth(active)
                name = args.name if args.name is not None else inferred_name(content)
                stored = vault / (name + '.json')
                checked_directory(vault, create=True, private=True)
                atomic_copy(content, stored, overwrite=args.force)
                remember_current(vault, name)
                print(f'저장됨: {stored}')
            elif args.command == 'logout':
                logout(active, vault)
            elif args.name is None:
                show_switches(active, vault)
            else:
                switch_account(active, vault, args.name)
        return 0
    except AuthError as exc:
        print(f'오류: {exc}', file=sys.stderr)
    except FileNotFoundError as exc:
        print(f'오류: 파일 또는 디렉터리가 없습니다: {exc.filename}', file=sys.stderr)
    except OSError as exc:
        if exc.errno in (errno.EACCES, errno.EPERM, errno.EROFS):
            print('오류: 쓰기/접근 권한이 없습니다. 일반 호스트 터미널에서 같은 사용자로 실행하세요.', file=sys.stderr)
        else:
            print(f'오류: 파일 작업 실패 ({exc.strerror}): {exc.filename}', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
